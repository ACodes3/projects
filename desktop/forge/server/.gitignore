
# ==========================================
# FORGE - Git Ignore
# ==========================================

# Dependencies
node_modules/
**/node_modules/

# Environment variables / secrets
.env
.env.*
!.env.example
!.env.*.example

# SQLite databases
*.sqlite
*.sqlite3
*.db
*.db-journal
*.sqlite-journal
*.sqlite3-journal
*.db-wal
*.db-shm
*.sqlite-wal
*.sqlite-shm
*.sqlite3-wal
*.sqlite3-shm

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# React / Vite build output
dist/
build/
coverage/

# Electron build output
out/
release/
*.exe
*.msi
*.dmg
*.AppImage

# Temporary files
tmp/
temp/
*.tmp
*.bak
*.swp

# OS files
.DS_Store
Thumbs.db
desktop.ini

# IDE-specific files
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Local configuration
*.local
